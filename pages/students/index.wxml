<view class="page tab-page"><view class="search"><image class="icon" src="/assets/icons/search.svg"/><input placeholder="搜索昵称、学校、年级或结对人" value="{{query}}" bindinput="search"/></view><view class="chips"><button wx:for="{{filters}}" wx:key="id" class="chip-wrap" data-id="{{item.id}}" bindtap="filter"><view class="chip {{filter===item.id?'active':''}}">{{item.text}}</view></button></view><view wx:if="{{error && status==='ready'}}" class="error-inline">{{error}}<button class="text-btn" bindtap="load">重试</button></view><state-view status="{{status}}" title="{{status==='empty'?'还没有孩子档案':''}}" message="{{error || '在后台建立档案后，这里将同步显示。'}}" bind:retry="load" bind:action="help"/><block wx:if="{{status==='ready'}}"><child-card wx:for="{{filtered}}" wx:key="id" student="{{item}}" admin="{{true}}" bind:open="open"/><state-view wx:if="{{!filtered.length}}" status="empty" title="没有找到匹配内容" message="试试其他关键词，或清除筛选。" actionText="清除筛选" bind:action="clear"/><view class="version">阶段 1 管理骨架 · 占位数据</view></block></view><role-tabs/>