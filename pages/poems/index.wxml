<page-meta page-style="{{filterOpen ? 'overflow:hidden;' : ''}}"/><view class="page tab-page"><view class="eyebrow">成长有迹，心自成诗</view><view class="title">把成长，写成诗</view><view class="subtitle">记录里那些小小的变化，值得被珍藏。</view><button class="btn full generate" bindtap="generate"><image class="icon" src="/assets/icons/star.svg"/>写一首成长诗</button><button class="student-filter" bindtap="toggleFilter" disabled="{{!role}}" aria-label="按孩子筛选，当前{{filterLabel}}" aria-expanded="{{filterOpen}}"><text class="filter-caption">陪伴对象</text><text class="filter-current">{{filterLabel}}</text><image class="filter-arrow" src="/assets/icons/arrow.svg"/></button><state-view status="{{status}}" title="{{status==='empty'?'第一首成长诗，等你写下':''}}" message="{{error || '从真实观察中，拾起成长的片段。'}}" actionText="{{status==='empty'?'写一首成长诗':'重试'}}" bind:retry="load" bind:action="generate"/><view wx:if="{{status==='ready'}}" class="stack"><button wx:for="{{filtered}}" wx:key="id" class="card poem-paper poem-item" data-id="{{item.id}}" data-student="{{item.student_id}}" bindtap="open"><image class="poem-cover" mode="aspectFill" src="{{item.cover_url || '/assets/landscape.svg'}}" data-id="{{item.id}}" binderror="coverError"/><view class="poem-content"><view class="list-title serif">{{item.title}}</view><view class="excerpt">{{item.excerpt}}</view><view class="row between"><text class="metadata">{{item.student_name}} · {{item.period}} · {{item.date}}</text><view class="tag ai">AI 生成诗文</view></view></view></button><state-view wx:if="{{!filtered.length}}" status="empty" title="没有匹配的成长诗" message="试试其他孩子，或写一首新诗。" actionText="清除筛选" bind:action="clear"/></view></view><view wx:if="{{filterOpen && (role==='volunteer' || role==='admin')}}" class="filter-layer"><view class="filter-mask" bindtap="closeFilter" catchtouchmove="preventMove"/><view class="filter-sheet" aria-role="dialog" aria-label="选择陪伴对象"><view class="filter-sheet-head"><button class="filter-sheet-toggle" bindtap="toggleFilter"><text class="section-title">选择陪伴对象</text><image class="filter-arrow expanded" src="/assets/icons/arrow.svg"/></button><button class="filter-close" bindtap="closeFilter" aria-label="收起筛选"><image class="icon" src="/assets/icons/close.svg"/></button></view><view class="filter-sheet-note small">当前选择：{{filterLabel}}</view><scroll-view class="filter-options" scroll-y="{{true}}" enhanced="{{true}}" bounces="{{false}}"><button class="filter-option {{filter==='all'?'selected':''}}" data-id="all" bindtap="filter"><text class="grow">全部</text><text wx:if="{{filter==='all'}}" class="filter-selected">已选</text></button><button wx:for="{{children}}" wx:key="id" class="filter-option {{filter===item.id?'selected':''}}" data-id="{{item.id}}" bindtap="filter"><view class="grow"><view>{{item.name}}</view><view wx:if="{{item.grade || item.school}}" class="metadata">{{item.grade}}{{item.grade && item.school?' · ':''}}{{item.school}}</view></view><text wx:if="{{filter===item.id}}" class="filter-selected">已选</text></button><view wx:if="{{!children.length}}" class="filter-no-children small">暂无可筛选的孩子，可查看全部内容。</view></scroll-view></view></view>