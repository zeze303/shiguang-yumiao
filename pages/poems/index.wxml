<view class="page tab-page"><view class="eyebrow">成长有迹，心自成诗</view><view class="title">把成长，写成诗</view><view class="subtitle">记录里那些小小的变化，值得被珍藏。</view><button class="btn full generate" bindtap="generate"><image class="icon" src="/assets/icons/star.svg"/>写一首成长诗</button><view class="chips"><button class="chip-wrap" data-id="all" bindtap="filter"><view class="chip {{filter==='all'?'active':''}}">全部</view></button><button wx:for="{{children}}" wx:key="id" class="chip-wrap" data-id="{{item.id}}" bindtap="filter"><view class="chip {{filter===item.id?'active':''}}">{{item.name}}</view></button></view><state-view status="{{status}}" title="{{status==='empty'?'第一首成长诗，等你写下':''}}" message="{{error || '从真实观察中，拾起成长的片段。'}}" actionText="{{status==='empty'?'写一首成长诗':'重试'}}" bind:retry="load" bind:action="generate"/><view wx:if="{{status==='ready'}}" class="stack"><button wx:for="{{filtered}}" wx:key="id" class="card poem-paper poem-item" data-id="{{item.id}}" data-student="{{item.student_id}}" bindtap="open"><image class="poem-cover" mode="aspectFill" src="{{item.cover_url || '/assets/landscape.svg'}}" data-id="{{item.id}}" binderror="coverError"/><view class="poem-content"><view class="list-title serif">{{item.title}}</view><view class="excerpt">{{item.excerpt}}</view><view class="row between"><text class="metadata">{{item.student_name}} · {{item.period}} · {{item.date}}</text><view class="tag ai">AI 生成诗文</view></view></view></button><state-view wx:if="{{!filtered.length}}" status="empty" title="没有匹配的成长诗" message="试试其他孩子，或写一首新诗。" actionText="清除筛选" bind:action="clear"/></view></view>