<view
  class="page tab-page"
>
  <view
    class="search"
  >
    <image
      class="icon"
      src="/assets/icons/search.svg"
    />
    <input
      placeholder="搜索志愿者或组织"
      value="{{query}}"
      bindinput="search"
    />
  </view>
  <view
    class="section-head"
  >
    <view
      class="section-title"
    >同行的志愿者</view>
    <button
      class="btn compact"
      bindtap="pending"
    >分配结对</button>
  </view>
  <view
    wx:if="{{error && status==='ready'}}"
    class="error-inline"
  >{{error}}<button
      class="text-btn"
      bindtap="load"
    >重试</button></view>
  <state-view
    status="{{status}}"
    title="还没有志愿者加入"
    message="{{error || '志愿者登录后会加入服务计划。'}}"
    bind:retry="load"
    bind:action="pending"
  />
  <view
    wx:if="{{status==='ready'}}"
    class="stack"
  >
    <button
      wx:for="{{filtered}}"
      wx:key="id"
      class="card volunteer"
      bindtap="pending"
    >
      <view
        class="row"
      >
        <view
          class="avatar"
        >{{item.initial}}</view>
        <view
          class="grow"
        >
          <view
            class="person-title"
          >{{item.name}}</view>
          <view
            class="small"
          >{{item.org}}</view>
        </view>
        <view
          class="tag"
        >{{item.relation_count}} 位结对</view>
      </view>
      <view
        class="card-footer"
      >
        <text>在岗 · 可查看结对与调整</text>
        <image
          class="icon small-icon"
          src="/assets/icons/arrow.svg"
        />
      </view>
    </button>
    <state-view
      wx:if="{{!filtered.length}}"
      status="empty"
      title="没有找到匹配内容"
      message="试试其他关键词。"
      actionText="清除搜索"
      bind:action="clear"
    />
  </view>
  <view
    class="version"
  >阶段 1 管理骨架 · 占位数据</view>
</view>
<role-tabs/>
