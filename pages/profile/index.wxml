<view
  class="page tab-page"
>
  <state-view
    status="{{status}}"
    title="{{status === 'empty' ? '资料暂未完善' : ''}}"
    message="{{error || '请联系组织管理员补充资料。'}}"
    actionText="重新登录"
    bind:retry="login"
    bind:action="login"
  />
  <block
    wx:if="{{status === 'ready'}}"
  >
    <view
      class="profile-hero"
    >
      <view
        class="row"
      >
        <view
          class="avatar large"
        >{{initial}}</view>
        <view
          class="grow"
        >
          <view
            class="profile-title"
          >{{profile.name}}</view>
          <view
            class="small"
          >{{profile.org || '所属组织待补充'}}</view>
          <view
            class="tag"
          >{{role === 'admin' ? '管理角色' : '结对志愿者'}}</view>
        </view>
      </view>
      <view
        wx:if="{{role === 'volunteer' || role === 'admin'}}"
        class="summary-grid"
      >
        <view>
          <text
            class="number"
          >{{counts[0]}}</text>
          <text
            class="metadata"
          >结对孩子</text>
        </view>
        <view>
          <text
            class="number"
          >{{counts[1]}}</text>
          <text
            class="metadata"
          >陪伴记录</text>
        </view>
        <view>
          <text
            class="number"
          >{{counts[2]}}</text>
          <text
            class="metadata"
          >成长诗</text>
        </view>
      </view>
      <view
        wx:else
        class="info-table"
      >
        <view
          class="row between"
        >
          <text
            class="muted"
          >可见范围</text>
          <text>全部孩子与志愿者</text>
        </view>
        <view
          class="row between"
        >
          <text
            class="muted"
          >管理职责</text>
          <text>结对分配 · 预警跟进</text>
        </view>
      </view>
    </view>
    <view
      class="card section"
    >
      <button
        wx:for="{{menus}}"
        wx:key="id"
        class="list-row"
        data-id="{{item.id}}"
        data-title="{{item.text}}"
        bindtap="menu"
      >
        <image
          class="icon"
          src="/assets/icons/{{item.icon}}.svg"
        />
        <text
          class="grow"
        >{{item.text}}</text>
        <image
          class="icon small-icon"
          src="/assets/icons/arrow.svg"
        />
      </button>
    </view>
    <view
      class="card section"
    >
      <button
        wx:for="{{helpMenus}}"
        wx:key="id"
        class="list-row"
        data-id="{{item.id}}"
        data-title="{{item.text}}"
        bindtap="menu"
      >
        <image
          class="icon"
          src="/assets/icons/{{item.icon}}.svg"
        />
        <text
          class="grow"
        >{{item.text}}</text>
        <image
          class="icon small-icon"
          src="/assets/icons/arrow.svg"
        />
      </button>
    </view>
    <button
      class="btn secondary full section"
      bindtap="logout"
      disabled="{{logoutBusy}}"
    >退出登录</button>
    <view
      class="version"
    ><view
        class="serif"
      >成长有迹，心自成诗</view>心迹成诗 · 拾光系 / v1.0</view>
  </block>
</view>
