<view
  class="page"
>
  <view
    class="title"
  >我陪伴着的孩子</view>
  <view
    class="subtitle"
  >{{items.length}} 段结对关系，每一步都值得认真。</view>
  <view
    class="notice"
  >
    <image
      class="icon"
      src="/assets/icons/link.svg"
    />
    <text>结对分配由组织管理者负责。如需调整，请联系你的组织负责人。</text>
  </view>
  <view
    wx:if="{{error && status==='ready'}}"
    class="error-inline"
  >{{error}}<button
      class="text-btn"
      bindtap="load"
    >重试</button></view>
  <state-view
    status="{{status}}"
    title="{{status === 'empty' ? '还没有结对的孩子' : ''}}"
    message="{{error || '请联系管理者安排陪伴。'}}"
    actionText="{{status === 'empty' ? '结对说明' : '重试'}}"
    bind:retry="load"
    bind:action="help"
  />
  <child-card
    wx:if="{{status === 'ready'}}"
    wx:for="{{items}}"
    wx:key="id"
    student="{{item}}"
    bind:open="open"
  />
</view>
