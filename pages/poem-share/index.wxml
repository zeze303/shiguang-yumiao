<view class="page with-action"><view class="section-head"><view><view class="section-title">成长诗分享卡</view><view class="small">一份温柔的成长纪念</view></view><view class="tag">{{showName?'昵称分享':'匿名分享'}}</view></view><state-view status="{{status}}" title="{{status==='empty'?'没有可分享的诗文':''}}" message="{{error || '请返回阅读页选择一首诗。'}}" actionText="{{status==='empty'?'返回阅读':'重试'}}" bind:retry="load" bind:action="back"/><block wx:if="{{status==='ready'}}"><view class="share-paper"><image class="poem-cover share-cover" src="/assets/landscape.svg" mode="aspectFill"/><view class="poem-reading"><view class="eyebrow">{{showName?'写给'+(poem.student_name||'你'):'给正在长大的你'}}</view><view class="poem-title">{{poem.title}}</view><view class="verse">{{poem.content}}</view></view><view class="share-bottom row between"><view><view class="serif brand">拾光育苗</view><view class="small">成长有迹，心自成诗</view><view class="metadata">AI 生成诗文 · 品牌插画</view></view><view class="stamp serif">拾光
育苗</view></view></view><checkbox-group bindchange="toggle"><label class="check-row"><checkbox value="name" checked="{{showName}}" color="#c0392b"/><text>在卡片上显示孩子昵称（分享前确认授权）</text></label></checkbox-group><view wx:if="{{busy}}" class="notice">正在合成分享卡，请稍候。</view><view wx:if="{{error}}" class="error-inline">{{error}}<button wx:if="{{denied}}" class="text-btn" bindtap="settings">相册设置</button></view></block><canvas type="2d" id="shareCanvas" class="export-canvas"/><view wx:if="{{status==='ready'}}" class="bottom-action"><button class="btn" disabled="{{busy}}" bindtap="save">{{busy?'正在合成':'保存分享卡'}}</button></view></view>