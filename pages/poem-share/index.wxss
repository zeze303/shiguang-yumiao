.share-paper{border-radius:32rpx;overflow:hidden;background:var(--surface-paper);box-shadow:0 16rpx 48rpx rgba(44,24,16,.09)}.share-cover{height:308rpx}.poem-title{font-size:48rpx;margin:12rpx 0 24rpx}.verse{font-size:30rpx;line-height:1.9}.share-bottom{padding:32rpx 48rpx;border-top:2rpx solid var(--accent-gold-light)}.brand{font-size:32rpx}.stamp{white-space:pre-line;border:2rpx solid var(--brand-deep);border-radius:6rpx;padding:8rpx;color:var(--brand-deep);font-size:30rpx;line-height:1.1;transform:rotate(-3deg)}.check-row{display:flex;align-items:center;gap:16rpx;margin-top:28rpx;min-height:88rpx;font-size:24rpx;color:var(--text-secondary)}.export-canvas{position:fixed;left:-9999px;top:0;width:750px;height:1000px;pointer-events:none}