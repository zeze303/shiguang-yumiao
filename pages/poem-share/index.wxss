.share-paper {
  border-radius: 32rpx;
  overflow: hidden;
  background: var(--surface-paper);
  box-shadow: 0 16rpx 48rpx rgba(44,24,16,.09);
}

.share-cover {
  height: 308rpx;
}

.poem-title {
  font-size: 48rpx;
  margin: 12rpx 0 24rpx;
}

.verse {
  font-size: 32rpx;
  line-height: 2.05;
}

.share-bottom {
  padding: 32rpx 48rpx;
  border-top: 2rpx solid var(--accent-gold-light);
}

.brand {
  font-size: 32rpx;
}

.stamp {
  flex: none;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: pre-line;
  text-align: center;
  border-radius: 20rpx;
  background: var(--brand-deep);
  color: var(--accent-gold-light);
  font: 34rpx/1.15 SimSun, serif;
  transform: rotate(-5deg);
}

.check-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 28rpx;
  min-height: 88rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

