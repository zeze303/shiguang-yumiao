.content {
  height: 348rpx;
  min-height: 348rpx;
  line-height: 48rpx;
}

.choice-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.choice {
  min-height: 96rpx;
  border: 2rpx solid var(--border-default);
  border-radius: 24rpx;
  background: var(--surface-paper);
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 24rpx;
}

.choice.active {
  border-color: var(--brand-primary);
  background: var(--tint-red);
  color: var(--brand-deep);
}
