.code {
  font-size: 30rpx;
  line-height: 48rpx;
  letter-spacing: 2rpx;
  word-break: break-all;
  margin: 24rpx 0;
  color: var(--brand-deep);
}

.result {
  border: 2rpx solid var(--accent-gold-light);
}

.button-hover {
  opacity: 0.82;
}

.invite-tabs {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.invite-tabs-inner {
  display: inline-flex;
  gap: 16rpx;
  min-width: 100%;
}

.invite-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  flex: none;
  min-height: 72rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--border-default);
  border-radius: 36rpx;
  background: var(--surface-paper);
  color: var(--text-secondary);
  font-size: 24rpx;
  line-height: 1;
  text-align: center;
}

.invite-tab.active {
  border-color: var(--brand-deep);
  background: var(--brand-deep);
  color: var(--surface-paper);
}

.invite-filter-empty {
  padding: 64rpx 24rpx;
  color: var(--text-secondary);
  font-size: 26rpx;
  line-height: 44rpx;
  text-align: center;
}

.invite-page-status {
  padding: 24rpx 0 40rpx;
  color: var(--text-secondary);
  font-size: 24rpx;
  line-height: 40rpx;
  text-align: center;
}
