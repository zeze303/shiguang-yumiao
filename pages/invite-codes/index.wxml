<view
  class="page"
>
  <view
    class="title"
  >邀请码管理</view>
  <view
    class="subtitle"
  >为获得组织授权的成员分配服务身份。</view>
  <view
    wx:if="{{role==='admin'}}"
    class="card section"
  >
    <view
      class="field"
    >
      <view
        class="label"
      >目标身份</view>
      <picker
        range="{{targets}}"
        range-key="label"
        value="{{targetIndex}}"
        bindchange="target"
        disabled="{{busy}}"
      >
        <view
          class="input"
        >{{targets[targetIndex].label}}</view>
      </picker>
    </view>
    <view
      class="field"
    >
      <view
        class="label"
      >有效天数（选填）</view>
      <input
        class="input"
        type="number"
        value="{{days}}"
        bindinput="days"
        disabled="{{busy}}"
        placeholder="1至365，留空长期有效"
      />
    </view>
    <button
      class="btn full"
      disabled="{{busy}}"
      hover-class="button-hover"
      bindtap="generate"
    >{{busy?'正在处理':'生成邀请码'}}</button>
  </view>
  <view
    wx:if="{{role==='admin' && result}}"
    class="notice result"
  >
    <view
      class="grow"
    >
      <view
        class="section-title"
      >新邀请码 · {{result.roleText}}</view>
      <view
        class="code"
      >{{result.code}}</view>
      <view
        class="small"
      >{{result.expiresText}}</view>
      <button
        class="text-btn"
        data-code="{{result.code}}"
        bindtap="copy"
      >复制邀请码</button>
    </view>
  </view>
  <view
    wx:if="{{error && status!=='error'}}"
    class="error-inline"
  >{{error}}</view>
  <view
    wx:if="{{role==='admin'}}"
    class="section-head section"
  >
    <view
      class="section-title"
    >邀请码列表</view>
    <button
      class="text-btn"
      bindtap="load"
      disabled="{{busy}}"
    >刷新</button>
  </view>
  <scroll-view
    wx:if="{{role==='admin'}}"
    class="invite-tabs"
    scroll-x="{{true}}"
    enhanced="{{true}}"
    show-scrollbar="{{false}}"
  >
    <view class="invite-tabs-inner">
      <button
        wx:for="{{tabs}}"
        wx:key="state"
        class="invite-tab {{filter===item.state?'active':''}}"
        data-state="{{item.state}}"
        bindtap="filterTab"
      >{{item.label}} {{item.count}}</button>
    </view>
  </scroll-view>
  <state-view
    status="{{status}}"
    title="{{status==='empty' && !items.length ? '还没有邀请码' : status==='empty' ? '当前筛选下没有邀请码' : ''}}"
    message="{{error || (status==='empty' && !items.length ? '选择身份与有效期后生成第一个邀请码。' : '切换其他状态或生成新的邀请码。')}}"
    actionText="{{status==='empty' && !items.length ? '生成邀请码' : '重试'}}"
    bind:retry="load"
    bind:action="generate"
  />
  <view
    wx:if="{{role==='admin' && status==='ready' && !visibleItems.length}}"
    class="invite-filter-empty"
  >当前筛选下没有邀请码，请切换其他状态。</view>
  <view
    wx:if="{{role==='admin' && status==='ready' && visibleItems.length}}"
    class="stack"
  >
    <view
      wx:for="{{visibleItems}}"
      wx:key="id"
      class="card"
    >
      <view
        class="row between"
      >
        <view
          class="person-title"
        >{{item.roleText}}</view>
        <view
          class="tag {{item.state==='active'?'good':''}}"
        >{{item.stateText}}</view>
      </view>
      <view
        class="code"
      >{{item.code}}</view>
      <view
        class="small"
      >生成于 {{item.createdText}} · {{item.expiresText}}</view>
      <view
        class="row between"
      >
        <button
          class="text-btn"
          data-code="{{item.code}}"
          bindtap="copy"
        >复制</button>
        <button
          wx:if="{{item.state==='active'}}"
          class="text-btn"
          data-id="{{item.id}}"
          bindtap="revoke"
          disabled="{{busy}}"
        >作废邀请码</button>
      </view>
    </view>
    <view wx:if="{{pageStatus==='loading'}}" class="invite-page-status">正在加载更多</view>
    <view wx:elif="{{pageStatus==='done' && visibleItems.length}}" class="invite-page-status">没有更多了</view>
  </view>
</view>
