<view
  class="page tab-page"
>
  <view
    class="eyebrow"
  >青溪服务计划 / 管理视角</view>
  <view
    class="title"
  >让每一份陪伴有回应</view>
  <view
    class="subtitle"
  >最新观察周期 {{overview.period || '暂无'}}</view>
  <state-view
    status="{{status}}"
    title="{{status==='empty'?'还没有成长档案':''}}"
    message="{{error || '请在后台建立档案后查看。'}}"
    bind:retry="load"
    bind:action="pending"
  />
  <block
    wx:if="{{status==='ready'}}"
  >
    <view
      class="metric-grid section"
    >
      <view
        wx:for="{{metrics}}"
        wx:key="label"
        class="card metric"
      >
        <view
          class="small"
        >{{item.label}}</view>
        <view
          class="metric-value"
        >{{item.value}}<text
            class="unit"
          >{{item.unit}}</text></view>
        <view
          class="metadata"
        >{{item.note}}</view>
      </view>
    </view>
    <view
      class="card section"
    >
      <view
        class="section-head"
      >
        <view
          class="section-title"
        >预警汇总</view>
        <button
          class="text-btn"
          bindtap="pending"
        >全部</button>
      </view>
      <button
        wx:for="{{overview.alerts}}"
        wx:key="id"
        class="list-row"
        data-id="{{item.id}}"
        bindtap="open"
      >
        <view
          class="avatar"
        >{{item.initial}}</view>
        <view
          class="grow"
        >
          <view
            class="person-title"
          >{{item.name}}</view>
          <view
            class="small"
          >{{item.volunteer_name || '尚未结对'}}</view>
        </view>
        <view
          class="tag warn"
        >{{item.severe?'高危信号':'预警信号'}}</view>
      </button>
    </view>
    <view
      class="card section"
    >
      <view
        class="section-title"
      >综合等级分布</view>
      <view
        wx:for="{{overview.distribution}}"
        wx:key="label"
        class="dist-row"
      >
        <text>{{item.label}}</text>
        <view
          class="dist-track"
        >
          <view
            style="background:{{item.color}};width:{{item.percent}}%"
          />
        </view>
        <text>{{item.count}}人 · {{item.percent}}%</text>
      </view>
      <view
        class="small"
      >综合等级与单维预警分别统计，不作为孩子或志愿者排名。</view>
    </view>
    <button
      class="card section full-card"
      bindtap="pending"
    >
      <view
        class="person-title"
      >还有 {{overview.unpaired_count}} 位孩子等待结对</view>
      <view
        class="small"
      >为陪伴安排一位同行的人</view>
    </button>
    <view
      class="version"
    >阶段 1 管理骨架 · 占位数据</view>
  </block>
</view>
<role-tabs/>
