.metric-grid {
  display: grid;
  grid-template-columns: repeat(2,minmax(0,1fr));
  gap: 24rpx;
}

.metric-value {
  font-size: 60rpx;
  line-height: 84rpx;
  font-weight: 600;
  margin: 8rpx 0;
}

.unit {
  font-size: 24rpx;
  font-weight: 400;
  margin-left: 8rpx;
}

.dist-row {
  display: grid;
  grid-template-columns: 72rpx 1fr 140rpx;
  gap: 20rpx;
  align-items: center;
  font-size: 24rpx;
  margin: 28rpx 0;
}

.dist-track {
  height: 16rpx;
  border-radius: 12rpx;
  background: var(--border-default);
  overflow: hidden;
}

.dist-track>view {
  height: 100%;
  border-radius: 12rpx;
}

.full-card {
  width: 100%;
  text-align: left;
}
