.profile-title {
  font-size: 44rpx;
  line-height: 62rpx;
  font-weight: 600;
}

.full-card {
  text-align: left;
  width: 100%;
  display: block;
}

.body-copy {
  font-size: 28rpx;
  line-height: 48rpx;
  margin: 24rpx 0;
}

.radar {
  position: relative;
  height: 464rpx;
  margin: 16rpx auto;
  width: 600rpx;
  max-width: 100%;
}

.radar canvas {
  width: 100%;
  height: 464rpx;
}

.dim-values {
  display: grid;
  grid-template-columns: repeat(4,1fr);
  gap: 12rpx;
  border-top: 2rpx solid var(--border-default);
  padding-top: 24rpx;
}

.dim-values>view {
  text-align: center;
}

.trend-canvas {
  width: 100%;
  height: 340rpx;
}

.trend-text {
  text-align: center;
}

.timeline {
  border-left: 2rpx solid var(--accent-gold-light);
  padding-left: 36rpx;
  margin: 24rpx 0;
}

.timeline-item {
  margin-bottom: 40rpx;
  position: relative;
}

.timeline-item::before {
  content: '';
  position: absolute;
  left: -45rpx;
  top: 8rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--accent-gold);
  border: 4rpx solid var(--surface-paper);
}

.with-action {
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}
