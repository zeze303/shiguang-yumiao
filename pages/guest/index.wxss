.guest-hero {
  border: 2rpx solid rgba(212,167,74,.28);
  border-radius: 32rpx;
  background: var(--surface-paper);
  padding: 40rpx;
  overflow: hidden;
}

.guest-hero .title {
  white-space: pre-line;
  font-size: 52rpx;
  line-height: 80rpx;
  margin: 24rpx 0;
}

.intro-copy {
  font-size: 28rpx;
  line-height: 48rpx;
  max-width: 540rpx;
}

.landscape {
  width: 100%;
  height: 260rpx;
  margin: 24rpx 0;
}

.body-copy {
  font-size: 28rpx;
  line-height: 48rpx;
  margin: 24rpx 0;
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(3,minmax(0,1fr));
  gap: 16rpx;
}

.metric-grid .card {
  padding: 24rpx 16rpx;
  text-align: center;
}

.number {
  font-size: 48rpx;
  line-height: 68rpx;
  font-weight: 600;
}
