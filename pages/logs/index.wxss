.log-card{width:100%;display:block;text-align:left;margin-bottom:24rpx}.record-title{font-size:30rpx;font-weight:600}.record-body{font-size:26rpx;line-height:44rpx;color:var(--text-secondary);margin-top:24rpx;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}.thumb-art{width:100%;height:172rpx;margin-top:24rpx;border-radius:20rpx}.upload-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20rpx;margin-top:24rpx}.thumb{width:100%;height:172rpx;border-radius:20rpx}