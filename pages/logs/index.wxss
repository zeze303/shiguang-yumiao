.log-card {
  width: 100%;
  display: block;
  text-align: left;
  margin-bottom: 24rpx;
}

.record-title {
  font-size: 30rpx;
  font-weight: 600;
}

.record-body {
  font-size: 26rpx;
  line-height: 44rpx;
  color: var(--text-secondary);
  margin-top: 24rpx;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/*两页使用一致的暖纸筛选抽屉，选择区独立滚动。*/

.student-filter {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 88rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 32rpx;
  background: var(--surface-paper);
  border: 2rpx solid var(--border-default);
  border-radius: 24rpx;
  font-size: 28rpx;
  line-height: 48rpx;
}

.filter-caption {
  flex: none;
  color: var(--text-secondary);
  font-size: 24rpx;
}

.filter-current {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-weight: 600;
}

.filter-arrow {
  width: 32rpx;
  height: 32rpx;
  flex: none;
  transform: rotate(90deg);
}

.filter-arrow.expanded {
  transform: rotate(-90deg);
}

.filter-layer {
  position: fixed;
  inset: 0;
  z-index: 1000;
}

.filter-mask {
  position: absolute;
  inset: 0;
  background: var(--overlay);
}

.filter-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--surface-paper);
  border-radius: 36rpx 36rpx 0 0;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 32rpx rgba(44,24,16,.045);
}

.filter-sheet-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.filter-sheet-toggle {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 88rpx;
  text-align: left;
}

.filter-close {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.filter-sheet-note {
  margin: 0 0 24rpx;
}

.filter-options {
  height: 50vh;
  max-height: 640rpx;
}

.filter-option {
  display: flex;
  align-items: center;
  gap: 24rpx;
  width: 100%;
  min-height: 104rpx;
  padding: 24rpx;
  border: 2rpx solid transparent;
  border-bottom-color: var(--border-default);
  font-size: 30rpx;
  line-height: 48rpx;
  text-align: left;
}

.filter-option.selected {
  background: var(--tint-red);
  border-color: rgba(192,57,43,.25);
  border-radius: 20rpx;
  color: var(--brand-deep);
  font-weight: 600;
}

.filter-selected {
  font-size: 24rpx;
  flex: none;
  color: var(--brand-deep);
}

.filter-no-children {
  padding: 32rpx 24rpx;
}
