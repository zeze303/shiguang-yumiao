<view class="page tab-page"><view class="section-head"><view class="grow"><view class="title">陪伴的足迹</view><view class="small">每一次认真倾听，都有回响。</view></view><button class="btn compact" bindtap="add"><image class="icon" src="/assets/icons/plus.svg"/>新增</button></view><view class="chips"><button class="chip-wrap" data-id="all" bindtap="filter"><view class="chip {{filter==='all'?'active':''}}">全部</view></button><button wx:for="{{children}}" wx:key="id" class="chip-wrap" data-id="{{item.id}}" bindtap="filter"><view class="chip {{filter===item.id?'active':''}}">{{item.name}}</view></button></view><view wx:if="{{error && status==='ready'}}" class="error-inline">{{error}}<button class="text-btn" bindtap="load">重试</button></view><state-view status="{{status}}" title="{{status==='empty'?'陪伴的第一页，等你写下':''}}" message="{{error || '留下这次陪伴的具体观察。'}}" actionText="{{status==='empty'?'新增记录':'重试'}}" bind:retry="load" bind:action="add"/><block wx:if="{{status==='ready'}}"><button wx:for="{{filtered}}" wx:key="id" class="card log-card" data-id="{{item.id}}" data-student="{{item.student_id}}" bindtap="open"><view class="row between"><view class="record-title">与{{item.student_name || '孩子'}}的一次{{item.type}}</view><view class="tag">{{item.type}}</view></view><view class="record-body">{{item.content}}</view><image wx:if="{{item.illustration}}" class="thumb-art" src="/assets/landscape.svg" mode="aspectFill"/><view wx:if="{{item.images.length}}" class="upload-grid"><image wx:for="{{item.images}}" wx:key="*this" class="thumb" src="{{item}}" mode="aspectFill"/></view><view class="card-footer"><text>{{item.date}} · {{item.volunteer_name || '记录人'}}</text><image class="icon small-icon" src="/assets/icons/arrow.svg"/></view></button><state-view wx:if="{{!filtered.length}}" status="empty" title="没有找到匹配内容" message="当前对象还没有陪伴记录。" actionText="清除筛选" bind:action="clear"/></block></view>