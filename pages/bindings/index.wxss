.intro {
  margin-bottom: 40rpx;
}

.intro .title {
  margin-top: 8rpx;
}

.hero {
  position: relative;
  overflow: hidden;
  padding: 40rpx;
  min-height: 292rpx;
  border: 2rpx solid rgba(212,167,74,.28);
  border-radius: 32rpx;
  background: var(--surface-paper);
  margin-bottom: 40rpx;
}

.art {
  position: absolute;
  right: -32rpx;
  bottom: -8rpx;
  width: 348rpx;
  height: 270rpx;
  opacity: .95;
}

.hero-title {
  position: relative;
  white-space: pre-line;
  font-size: 40rpx;
  line-height: 60rpx;
  max-width: 420rpx;
  margin-top: 16rpx;
}

.hero .eyebrow,.hero .text-btn {
  position: relative;
}

.seal {
  white-space: pre-line;
}
