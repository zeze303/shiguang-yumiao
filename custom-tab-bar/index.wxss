:host {
  --surface-paper: #fdf8f0;
  --brand-primary: #c0392b;
}

.tabbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  box-sizing: border-box;
  min-height: 100rpx;
  padding: 10rpx 0 calc(10rpx + env(safe-area-inset-bottom));
  background: #fdf8f0;
  border-top: 2rpx solid rgba(44,24,16,.12);
}

.tab {
  flex: 1;
  border: 0;
  margin: 0;
  padding: 0;
  min-height: 88rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  color: #6c5d56;
  background: transparent;
  font-size: 20rpx;
  line-height: 32rpx;
  border-radius: 0;
}

.tab::after {
  border: 0;
}

.tab image {
  width: 46rpx;
  height: 46rpx;
}

.selected {
  color: #c0392b;
  font-weight: 600;
}
