SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
WX_APPID=
WX_SECRET=
DEEPSEEK_API_KEY=
PORT=3000

# Public overview exposes scale counts only, never score or grade aggregates.
NODE_ENV=development
# Production must set true and mount backend/data on a persistent single-instance disk.
AI_SINGLE_INSTANCE=false
AI_ACCOUNT_DAILY_LIMIT=20
AI_MAX_CONCURRENCY=3
AI_GLOBAL_DAILY_UNITS=500
AI_IDEMPOTENCY_TTL_DAYS=7
AI_IDEMPOTENCY_MAX_RECORDS=10000

# OpenAI-compatible image generation; empty key keeps the default cover.
IMAGE_API_KEY=
IMAGE_API_BASE=https://quanzil.com/v1
IMAGE_MODEL=gpt-image-2

# Public Storage bucket for persistent covers; requires SUPABASE_URL and service role key.
SUPABASE_COVERS_BUCKET=shiguang-covers
# Comma-separated exact HTTPS hostnames for provider image downloads (no redirects).
# Empty uses the IMAGE_API_BASE hostname; add the actual provider CDN after verification.
IMAGE_DOWNLOAD_HOSTS=

# true enables WeChat text checks when WX_APPID and WX_SECRET are configured.
# Development may skip checks. Production requires true and complete credentials or refuses startup.
WX_CONTENT_SECURITY=false
