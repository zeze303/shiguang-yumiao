SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
WX_APPID=
WX_SECRET=
DEEPSEEK_API_KEY=
PORT=3000

# Minimum distinct scored children and minimum non-empty grade cell for public release.
# Default 5; invalid values or values below 2 fall back to 5.
PUBLIC_OVERVIEW_MIN_SAMPLES=5

# OpenAI-compatible image generation; empty key keeps the default cover.
IMAGE_API_KEY=
IMAGE_API_BASE=https://quanzil.com/v1
IMAGE_MODEL=gpt-image-2

# true enables WeChat text checks when WX_APPID and WX_SECRET are configured.
# Missing credentials or false skips checks. Enabled provider failures block content.
WX_CONTENT_SECURITY=false
