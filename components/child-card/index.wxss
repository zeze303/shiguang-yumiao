:host{display:block;margin-bottom:24rpx}.full-card{display:block;width:100%;text-align:left}.child-top{align-items:flex-start}.child-top .tag{margin-top:4rpx;flex:none}.mini-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20rpx;margin-top:32rpx}.mini-label{display:flex;justify-content:space-between;gap:4rpx;font-size:22rpx;line-height:36rpx;color:var(--text-secondary)}.mini-track{height:8rpx;border-radius:8rpx;background:var(--border-default);overflow:hidden;margin-top:12rpx}.mini-fill{height:100%;border-radius:8rpx}