.skeleton {
  display: block;
}

.sk-card {
  padding: 28rpx;
  margin-bottom: 24rpx;
  border-radius: 24rpx;
  background: var(--surface-paper);
  border: 2rpx solid var(--border-default);
}

.sk-line,
.sk-chip,
.sk-block {
  background: linear-gradient(90deg, var(--border-default) 25%, var(--surface-paper) 50%, var(--border-default) 75%);
  background-size: 400% 100%;
  animation: sk-shimmer 1.4s ease-in-out infinite;
  border-radius: 8rpx;
}

.sk-line {
  height: 24rpx;
  margin-bottom: 18rpx;
}

.sk-line.w40 {
  width: 40%;
}

.sk-line.w70 {
  width: 70%;
  margin-bottom: 26rpx;
}

.sk-block {
  height: 220rpx;
  border-radius: 16rpx;
}

.sk-row {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16rpx;
}

.sk-chip {
  height: 72rpx;
  border-radius: 12rpx;
}

@keyframes sk-shimmer {
  0% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0 50%;
  }
}

@media (prefers-reduced-motion: reduce) {
  .sk-line,
  .sk-chip,
  .sk-block {
    animation: none;
  }
}
